{
    "manifests": {
        "frosh/devenv-meta": {
            "manifest": {
                "copy-from-recipe": {
                    "root/": ""
                },
                "gitignore": [
                    ".devenv*",
                    "devenv.local.nix",
                    ".direnv*"
                ],
                "post-install-output": [
                    "  * <fg=blue>Setup</> devenv:",
                    "",
                    "    1. Install the Nix package manager - <comment>https://nixos.org/download.html#download-nix</>",
                    "    2. Install devenv 2.4 or newer - <comment>https://devenv.sh/getting-started/</>",
                    "",
                    "  * <fg=blue>Run</> devenv:",
                    "",
                    "    1. <comment>devenv shell</> activates your developer environment",
                    "    2. <comment>devenv up</> starts processes",
                    "    3. <comment>bin/console system:install --basic-setup</> installs Shopware",
                    "",
                    "  * <fg=blue>Read</> the documentation at <comment>https://devenv.sh/getting-started/</>"
                ]
            },
            "files": {
                "root/.envrc": {
                    "contents": [
                        "#!/usr/bin/env bash",
                        "",
                        "eval \"$(devenv direnvrc)\"",
                        "",
                        "use devenv",
                        ""
                    ],
                    "executable": false
                },
                "root/devenv.lock": {
                    "contents": [
                        "{",
                        "  \"nodes\": {",
                        "    \"devenv\": {",
                        "      \"locked\": {",
                        "        \"dir\": \"src/modules\",",
                        "        \"lastModified\": 1790701375,",
                        "        \"narHash\": \"sha256-0FpLHIRDYiyo3EMTnMQSobZQknZaa3JuWo6vmMCK76o=\",",
                        "        \"owner\": \"cachix\",",
                        "        \"repo\": \"devenv\",",
                        "        \"rev\": \"fe20b5cba7ab5e93ae73f956a8d3efc50e1753f4\",",
                        "        \"type\": \"github\"",
                        "      },",
                        "      \"original\": {",
